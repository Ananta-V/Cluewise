{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/admin117", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/(.*)", "destination": "/api/[...route].js?route=$1" }
  ],
  "functions": {
    "api/[...route].js": { "maxDuration": 15 },
    "api/index.js": { "maxDuration": 15 }
  }
}
